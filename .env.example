# Copy to .env and adjust. Never commit .env.
OLLAMA_MODEL=phi4-mini
OLLAMA_HOST=http://localhost:11434
DB_PATH=data/generated/nullpunkt.db
# Analyst accounts (default data/generated/accounts.db, kept apart from the shift database).
# ACCOUNTS_DB_PATH=data/generated/accounts.db
# Team password: when set, creating an account asks for it, so strangers can't sign up.
# DEMO_PASSCODE=choose-a-team-password

# Email for sign-up and password-reset codes, sent through Gmail. SMTP_PASSWORD must be a Google
# App Password (Google account -> Security -> 2-Step Verification -> App passwords), not your
# normal Gmail password.
# SMTP_USER=yourteam@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop
# MAIL_FROM=Nullpunkt <yourteam@gmail.com>
# Local testing without Gmail: print the emails in the terminal instead of sending them.
# MAIL_BACKEND=console
